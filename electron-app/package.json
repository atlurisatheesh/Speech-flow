{
  "name": "speech-flow-app",
  "private": true,
  "version": "1.0.0",
  "description": "Speech-Flow - AI Voice Assistant for Windows",
  "author": "Atluri Satheesh",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc -p tsconfig.electron.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:5173 && tsc -p tsconfig.electron.json -w\" \"wait-on http://localhost:5173 && wait-on dist-electron/main.js && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "lucide-react": "^0.344.0",
    "openai": "^4.28.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.20",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.0.1",
    "electron-builder": "^24.9.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.atluri.speechflow",
    "productName": "Speech-Flow",
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico",
      "signAndEditExecutable": false,
      "signingHashAlgorithms": []
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false
    },
    "extraResources": [
      {
        "from": "../dist/SpeechFlow-Widget",
        "to": "SpeechFlow-Widget",
        "filter": ["**/*"]
      },
      {
        "from": "../dist/SpeechFlow-Backend",
        "to": "SpeechFlow-Backend",
        "filter": ["**/*"]
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  }
}

